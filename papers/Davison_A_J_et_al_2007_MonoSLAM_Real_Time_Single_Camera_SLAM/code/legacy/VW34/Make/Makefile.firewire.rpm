FWRPMNAME = VWFirewire
FWRPMFILES = firewire.files

# The RPM requires uptodate tgz file
firewirerpm: ~/.rpmmacros rpmcommon
#   1. Create list of files to include in rpm
	cd $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW; \
	cat $(FWRPMFILES) > tmp.txt; \
	/bin/sed -e 's/^/\/usr\/include\/VW\//' tmp.txt > headerfiles.txt; \
#   2. Set the version string in the spec file and cat together
	/bin/sed -e 's/--VERSION--/'$(VERSION)'/' -e 's/--RELEASE--/'$(TODAY)'/' $(FWRPMNAME)/$(FWRPMNAME).spec > $(RPMBUILDROOT)/SPEC/$(FWRPMNAME)-$(VERSION)-$(TODAY).spec.header; \
	cat $(RPMBUILDROOT)/SPEC/$(FWRPMNAME)-$(VERSION)-$(TODAY).spec.header $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW/headerfiles.txt > $(RPMBUILDROOT)/SPEC/$(FWRPMNAME)-$(VERSION)-$(TODAY).spec; \
#   3. make the RPM and copy it back
	cd $(RPMBUILDROOT)/SPEC; \
	rpmbuild -ba -vv $(FWRPMNAME)-$(VERSION)-$(TODAY).spec;
	cp $(RPMBUILDROOT)/RPMS/i386/$(FWRPMNAME)-$(VERSION)-$(TODAY).i386.rpm $(VWDIR)
	cp $(RPMBUILDROOT)/BUILD/VW-$(VERSION)/$(FWRPMNAME)-$(VERSION)-$(TODAY).* $(VWDIR)
	more $(FWRPMNAME)-$(VERSION)-$(TODAY).report

