RPMNAME = VWCore
RPMFILES = math.files utils.files iobasics.files image.files geom.files sequencers.files improc.files graphics.files

# The RPM requires uptodate tgz file
rpm: ~/.rpmmacros rpmcommon
#   1. Create list of files to include in rpm
	cd $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW; \
	cat $(RPMFILES) > $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW/tmp.txt; \
	/bin/sed -e 's/^/\/usr\/include\/VW\//' tmp.txt > $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW/headerfiles.txt; \
#   2. Set the version string in the spec file and cat together
	/bin/sed -e 's/--VERSION--/'$(VERSION)'/' -e 's/--RELEASE--/'$(TODAY)'/' $(RPMNAME)/$(RPMNAME).spec > $(RPMBUILDROOT)/SPEC/$(RPMNAME)-$(VERSION)-$(TODAY).spec.header; \
	cat $(RPMBUILDROOT)/SPEC/$(RPMNAME)-$(VERSION)-$(TODAY).spec.header $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW/headerfiles.txt > $(RPMBUILDROOT)/SPEC/$(RPMNAME)-$(VERSION)-$(TODAY).spec; \
#   3. make the RPM and copy it back
	cd $(RPMBUILDROOT)/SPEC; \
	rpmbuild -ba -vv $(RPMNAME)-$(VERSION)-$(TODAY).spec;
	cp $(RPMBUILDROOT)/RPMS/i386/VW-$(VERSION)-$(TODAY).i386.rpm $(VWDIR)
	cp $(RPMBUILDROOT)/BUILD/VW-$(VERSION)/VW-$(VERSION)-$(TODAY).* $(VWDIR)
	more VW-$(VERSION)-$(TODAY).report

