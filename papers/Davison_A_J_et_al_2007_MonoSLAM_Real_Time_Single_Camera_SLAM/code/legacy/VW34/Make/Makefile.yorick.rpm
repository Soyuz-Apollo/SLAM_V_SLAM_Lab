YORRPMNAME = VWYorick
YORRPMFILES = yorick.files

# The RPM requires uptodate tgz file
yorickrpm: ~/.rpmmacros rpmcommon
#   1. Create list of files to include in rpm
	cd $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW; \
	cat $(YORRPMFILES) > tmp.txt; \
	/bin/sed -e 's/^/\/usr\/include\/VW\//' tmp.txt > headerfiles.txt; \
#   2. Set the version string in the spec file and cat together
	/bin/sed -e 's/--VERSION--/'$(VERSION)'/' -e 's/--RELEASE--/'$(TODAY)'/' $(YORRPMNAME)/$(YORRPMNAME).spec > $(RPMBUILDROOT)/SPEC/$(YORRPMNAME)-$(VERSION)-$(TODAY).spec.header; \
	cat $(RPMBUILDROOT)/SPEC/$(YORRPMNAME)-$(VERSION)-$(TODAY).spec.header $(RPMBUILDROOT)/SOURCES/VW-$(VERSION)/include/VW/headerfiles.txt > $(RPMBUILDROOT)/SPEC/$(YORRPMNAME)-$(VERSION)-$(TODAY).spec; \
#   3. make the RPM and copy it back
	cd $(RPMBUILDROOT)/SPEC; \
	rpmbuild -ba -vv $(YORRPMNAME)-$(VERSION)-$(TODAY).spec;
	cp $(RPMBUILDROOT)/RPMS/i386/$(YORRPMNAME)-$(VERSION)-$(TODAY).i386.rpm $(VWDIR)
	cp $(RPMBUILDROOT)/BUILD/VW-$(VERSION)/$(YORRPMNAME)-$(VERSION)-$(TODAY).* $(VWDIR)
	more $(YORRPMNAME)-$(VERSION)-$(TODAY).report
